<?xml version="1.0"?>
<launch>
    <!-- rover -->
    <node name="rover serial" pkg="micro_ros_agent" exec="micro_ros_agent" args="serial --dev /dev/rover -v4"/>
    <node name="publish odom" pkg="mecanumrover3_bringup" exec="pub_odom"/>
    <!-- joycon -->
    <include file="$(find teleop_manager)/launch/teleop_manager.launch.xml"/>
    <!-- lidar -->
    <include file="$(find ydlidar_ros2_driver)/launch/ydlidar.launch.py"/>
    <!-- Realsense -->
    <include file="$(find rslidar)/tbd"/>
</launch>
