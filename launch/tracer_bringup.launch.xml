<?xml version="1.0"?>
<launch>

    <!-- Joy -->
    <arg name="max_x" default="0.8"/>
    <arg name="max_y" default="0.4"/>
    <arg name="max_auto" default="0.4"/>
    <arg name="max_yawrate" default="0.8"/>
    <arg name="stop_dist" default="0.5"/>
    <arg name="output" default="screen"/>
    <node name="teleop_manager" pkg="teleop_manager" exec="teleop_manager_node" output="$(var output)">
        <param name="max_x_velocity" value="$(var max_x)"/>
        <param name="max_y_velocity" value="$(var max_y)"/>
        <param name="max_yawrate" value="$(var max_yawrate)"/>
        <param name="max_auto_velocity" value="$(var max_auto)"/>
        <remap from="/cmd_vel" to="/tracer_twist"/>
        <remap from="/local_path_cmd_vel" to="/cmd_vel"/>
    </node>
    <node name="joy" pkg="joy" exec="joy_node"/>

    <!-- Tracer -->
    <arg name="use_sim_time" default="false" description="Use simulation clock if true"/>
    <arg name="port_name" default="can0" description="CAN bus name, e.g. can0"/>
    <arg name="odom_frame" default="odom" description="Odometry frame id"/>
    <arg name="base_frame" default="base_link" description="Base link frame id"/>
    <arg name="odom_topic_name" default="odom" description="Odometry topic name"/>
    <arg name="is_tracer_mini" default="false" description="Scout mini model"/>
    <arg name="simulated_robot" default="false" description="Whether running with simulator"/>
    <arg name="control_rate" default="50" description="Simulation control loop update rate"/>

    <node pkg="tracer_base" exec="tracer_base_node" name="tracer_base_node" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param name="port_name" value="$(var port_name)"/>
        <param name="odom_frame" value="$(var odom_frame)"/>
        <param name="base_frame" value="$(var base_frame)"/>
        <param name="odom_topic_name" value="$(var odom_topic_name)"/>
        <param name="is_tracer_mini" value="$(var is_tracer_mini)"/>
        <param name="simulated_robot" value="$(var simulated_robot)"/>
        <param name="control_rate" value="$(var control_rate)"/>
        <remap from="cmd_vel" to="tracer_twist"/>
    </node>
</launch>
